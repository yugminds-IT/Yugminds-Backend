generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  school_admin
  teacher
  student
}

// ============ Auth & Core ============
model Tenant {
  id        String   @id @default(uuid())
  name      String
  domain    String   @unique
  users     User[]
  createdAt DateTime @default(now())
}

model User {
  id                       Int                         @id @default(autoincrement())
  email                    String                      @unique
  password                 String
  /// Plaintext copy of the current password, kept only until the user
  /// changes it (cleared on every password-change path). Lets admins
  /// retrieve/export a working initial password for accounts that
  /// haven't been logged into yet — never populated for a self-chosen
  /// password.
  initialPassword          String?
  role                     Role
  isSuperAdmin             Boolean                     @default(false)
  isActive                 Boolean                     @default(true)
  mustChangePassword       Boolean                     @default(false)
  deletedAt                DateTime?
  tokenVersion             Int                         @default(0)
  tenantId                 String?
  tenant                   Tenant?                     @relation(fields: [tenantId], references: [id])
  profile                  Profile?
  teacherSchools           TeacherSchool[]
  teacherWorkingDaysHistory TeacherWorkingDaysHistory[]
  teacherSectionAssignments TeacherSectionAssignment[]
  studentSchools           StudentSchool[]
  schoolAdmins             SchoolAdmin[]
  notifications            Notification[]
  sentNotifications        Notification[]               @relation("NotificationSender")
  notificationReplies      NotificationReply[]
  teacherLeaves             TeacherLeave[]
  assignmentSubmissions    AssignmentSubmission[]
  createdAssignments       Assignment[]                 @relation("TeacherAssignments")
  grantedRetakeEntries     RetakeGrant[]               @relation("TeacherRetakeGrants")
  studentRetakeEntries     RetakeGrant[]               @relation("StudentRetakeGrants")
  studentRetakeRequests    RetakeRequest[]             @relation("StudentRetakeRequests")
  decidedRetakeRequests    RetakeRequest[]             @relation("TeacherRetakeRequestDecisions")
  studentScores            StudentScore[]              @relation("StudentScoreOwner")
  certificates             StudentCertificate[]
  issuedCertificates       StudentCertificate[]        @relation("StudentCertificateIssuedBy")
  revokedCertificates      StudentCertificate[]        @relation("StudentCertificateRevokedBy")
  authActivities           AuthActivity[]
  passwordResetRequests    PasswordResetRequest[]
  approvedPasswordResets   PasswordResetRequest[]      @relation("ApprovedBy")
  auditLogs                AuditLog[]                  @relation("AuditActor")
  savedViews               AdminSavedView[]
  createdAt                DateTime                    @default(now())
}

// ============ Profile (extended user info) ============
// Fields are role-specific:
//   Teachers  → qualification, experience, specialization
//   Students  → parentName, parentPhone
//   All roles → fullName, phone, schoolId, notification prefs
model Profile {
  id           String   @id @default(uuid())
  userId       Int      @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName       String?
  phone          String?
  // Teacher-only fields
  qualification  String?
  experience     String?
  specialization String?
  // Student-only fields
  parentName     String?
  parentPhone  String?
  schoolId     String?
  // Notification preferences (all roles)
  emailNotifications Boolean @default(true)
  assignmentReminders Boolean @default(true)
  gradeNotifications Boolean @default(true)
  courseUpdates Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([userId])
  @@index([schoolId])
}

// ============ School (extends Tenant concept) ============
model School {
  id                    String   @id @default(uuid())
  // Sequential numeric id, used only for S3 storage paths (e.g. logos/<schoolNumber>/...)
  // so bucket folders read "1, 2, 3" instead of raw UUIDs. Not a primary key.
  schoolNumber          Int      @unique @default(autoincrement())
  name                  String
  schoolCode            String?  @unique
  email                 String?
  phone                 String?
  address               String?
  city                  String?
  state                 String?
  country               String?
  pincode               String?
  principalName         String?
  affiliationType        String?
  schoolType            String?
  establishedYear       Int?
  totalStudentsEstimate Int?
  totalTeachersEstimate Int?
  isActive              Boolean  @default(true)
  deletedAt             DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  teacherSchools TeacherSchool[]
  teacherWorkingDaysHistory TeacherWorkingDaysHistory[]
  studentSchools StudentSchool[]
  schoolAdmins   SchoolAdmin[]
  courses        CourseAccess[]
  rooms          Room[]
  periods        Period[]
  joinCodes      JoinCode[]
  grades         Grade[]
  teacherSectionAssignments TeacherSectionAssignment[]
  assignments    Assignment[]
  studentScores  StudentScore[]
  schoolCalendars SchoolCalendar[]
  robocodersLicenses RobocodersLicense[]
  @@index([schoolCode])
}

// ============ Grade (per school) ============
model Grade {
  id        String     @id @default(uuid())
  schoolId  String
  name      String
  school    School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sections  Section[]
  joinCodes JoinCode[]
  assignments Assignment[]
  studentScores StudentScore[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  @@unique([schoolId, name])
  @@index([schoolId])
}

// ============ Section (per grade) ============
model Section {
  id                   String                    @id @default(uuid())
  gradeId              String
  name                 String
  grade                Grade                     @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  joinCodes            JoinCode[]
  teacherAssignments   TeacherSectionAssignment[]
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  @@unique([gradeId, name])
  @@index([gradeId])
}

// ============ Teacher–Section assignment (per school) ============
model TeacherSectionAssignment {
  id         String   @id @default(uuid())
  teacherId  Int
  sectionId  String
  schoolId   String
  teacher    User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  section    Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  status     String   @default("active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@unique([teacherId, sectionId])
  @@index([teacherId])
  @@index([sectionId])
  @@index([schoolId])
}

// ============ Teacher-School assignment ============
// gradesAssigned removed: derive from TeacherSectionAssignment → section → grade instead.
model TeacherSchool {
  id                  String   @id @default(uuid())
  teacherId           Int
  schoolId            String
  school              School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher             User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subjects            String[] @default([])
  workingDaysPerWeek  Int      @default(5)
  // Which weekdays this teacher works at this specific school — 0=Sun..6=Sat,
  // same convention as ClassSchedule.dayOfWeek/Date.getUTCDay(). Drives the
  // admin attendance dashboard's "total working days" math; kept in sync
  // with workingDaysPerWeek (= workingDays.length) on every write.
  workingDays         Int[]    @default([1, 2, 3, 4, 5])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  @@unique([teacherId, schoolId])
  @@index([teacherId])
  @@index([schoolId])
}

// Dated history of TeacherSchool.workingDays changes — a mid-month change
// (e.g. Mon-Thu -> Mon-Fri) must only apply from its effective date forward,
// not retroactively rewrite earlier attendance. TeacherSchool.workingDays
// stays as a denormalized "current" value for quick reads/UI defaults; every
// attendance calculation resolves the applicable entry here per-day instead.
model TeacherWorkingDaysHistory {
  id              String   @id @default(uuid())
  teacherId       Int
  schoolId        String
  teacher         User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  workingDays     Int[]    // 0=Sun..6=Sat — in effect from effectiveFrom until superseded
  effectiveFrom   DateTime // UTC-midnight-anchored date, inclusive
  createdByUserId Int?
  createdAt       DateTime @default(now())
  @@unique([teacherId, schoolId, effectiveFrom])
  @@index([teacherId, schoolId, effectiveFrom])
}

// ============ Student-School enrollment ============
model StudentSchool {
  id        String   @id @default(uuid())
  studentId Int
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  grade     String?
  section   String?
  joiningCode String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([studentId, schoolId])
  @@index([studentId])
  @@index([schoolId])
  @@index([grade])
  @@index([section])
  @@index([schoolId, grade, section])
}

// ============ School Admin ============
model SchoolAdmin {
  id        String   @id @default(uuid())
  userId    Int
  schoolId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([userId, schoolId])
  @@index([userId])
  @@index([schoolId])
}

// ============ Courses ============
model Course {
  id          String   @id @default(uuid())
  // Sequential numeric id, used only for S3 storage paths. Not a primary key.
  courseNumber Int     @unique @default(autoincrement())
  title       String
  description String?
  // Store potentially large base64/data URLs for thumbnails.
  // Without `@db.Text`, Postgres rejects uploads with "value too long".
  thumbnailUrl String? @db.Text
  isPublished Boolean  @default(false)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  chapters    Chapter[]
  courseAccess CourseAccess[]
  versions    CourseVersion[]
  certificates StudentCertificate[]
  assignments Assignment[]
  studentScores StudentScore[]
  @@index([isPublished])
}

model StudentCertificate {
  id             String   @id @default(uuid())
  studentId      Int
  student        User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId       String
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  certificateName String
  certificateUrl  String   @db.Text
  certificateKey String?  @db.Text
  // active | broken | revoked — "broken" is only ever set by an explicit
  // Verify action (a real S3 existence check), never inferred automatically,
  // since checking every row on every list load would be too slow.
  status         String    @default("active")
  issuedAt       DateTime @default(now())
  issuedBy       Int?
  issuedByUser   User?    @relation("StudentCertificateIssuedBy", fields: [issuedBy], references: [id], onDelete: SetNull)
  // Revoke is a soft delete (status flips to "revoked") so there's an audit
  // trail and the public verify page can say "revoked" instead of folding
  // into "never existed".
  revokedAt      DateTime?
  revokedBy      Int?
  revokedByUser  User?    @relation("StudentCertificateRevokedBy", fields: [revokedBy], references: [id], onDelete: SetNull)
  revokedReason  String?   @db.Text
  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
  @@index([issuedAt])
  @@index([status])
}

model CourseVersion {
  id              String   @id @default(uuid())
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  versionNumber   Int
  changesSummary  String?  @db.Text
  snapshot        Json?    // full course state for revert
  createdAt       DateTime @default(now())
  @@unique([courseId, versionNumber])
  @@index([courseId])
}

model Chapter {
  id        String   @id @default(uuid())
  // Sequential numeric id, used only for S3 storage paths. Not a primary key.
  chapterNumber Int  @unique @default(autoincrement())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  assignments Assignment[]
  contents   ChapterContent[]
  @@index([courseId])
}

model ChapterContent {
  id              String   @id @default(uuid())
  chapterId       String
  chapter         Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  contentType     String   // text | video | video_link | pdf | image | file | audio | html | link
  title           String
  contentText     String?  @db.Text
  contentUrl      String?
  sortOrder       Int      @default(0)
  durationMinutes Int?
  storagePath     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([chapterId])
}

model Assignment {
  id        String   @id @default(uuid())
  chapterId String?
  chapter   Chapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  courseId  String?
  course    Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  gradeId   String?
  grade     Grade?   @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  teacherId Int?
  teacher   User?    @relation("TeacherAssignments", fields: [teacherId], references: [id], onDelete: SetNull)
  schoolId  String?
  school    School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  subject   String?
  assignmentType String @default("COURSE") // COURSE | DAILY
  academicYear String?
  title     String
  description String? @db.Text
  instructions String? @db.Text
  attachments Json?   // array of { name, url }
  dueDate   DateTime?
  totalMarks Float?
  isPublished Boolean @default(false)
  publishScope String  @default("grade") // grade | section | selected_students
  publishedGradeIds String[] @default([])
  publishedSectionIds String[] @default([])
  retakeEnabled Boolean @default(false)
  maxRetakeAttempts Int? // null means unlimited when retakeEnabled=true
  retakeScoringRule String @default("latest") // highest | latest
  retakeWindowOpen Boolean @default(false)
  retakeAccessScope String @default("all") // all | selected
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  questions AssignmentQuestion[]
  submissions AssignmentSubmission[]
  retakeGrants RetakeGrant[]
  retakeRequests RetakeRequest[]
  @@index([chapterId])
  @@index([courseId])
  @@index([gradeId])
  @@index([teacherId])
  @@index([schoolId])
  @@index([assignmentType])
}

model AssignmentSubmission {
  id                 String     @id @default(uuid())
  assignmentId       String
  assignment         Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId          Int
  student            User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  gradedByTeacherId  Int?
  attemptNumber      Int        @default(1)
  answers            Json?
  fileUrl            String?
  textContent        String?    @db.Text
  feedback           String?    @db.Text
  status             String     @default("submitted") // pending | submitted | graded | late
  score              Float?
  maxScore           Float?
  isRetake           Boolean    @default(false)
  submittedAt        DateTime   @default(now())
  gradedAt           DateTime?
  @@unique([assignmentId, studentId, attemptNumber])
  @@index([studentId])
  @@index([assignmentId])
  @@index([assignmentId, studentId])
  @@index([studentId, status])
}

model RetakeGrant {
  id                 String     @id @default(uuid())
  assignmentId       String
  assignment         Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId          Int
  student            User       @relation("StudentRetakeGrants", fields: [studentId], references: [id], onDelete: Cascade)
  grantedByTeacherId Int
  grantedByTeacher   User       @relation("TeacherRetakeGrants", fields: [grantedByTeacherId], references: [id], onDelete: Cascade)
  grantedAt          DateTime   @default(now())
  isActive           Boolean    @default(true)
  specific           Boolean    @default(true) // true = individual grant; false = class-wide
  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@index([grantedByTeacherId])
}

// A student-initiated request to be granted a retake, routed to the
// teacher(s) who actually teach that student's grade/section at that
// school (resolved at creation time — see EnrollmentService-style logic in
// TeacherExtraController). Approving a request upserts a RetakeGrant, same
// mechanism as a teacher manually granting one.
model RetakeRequest {
  id                 String     @id @default(uuid())
  assignmentId       String
  assignment         Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId          Int
  student            User       @relation("StudentRetakeRequests", fields: [studentId], references: [id], onDelete: Cascade)
  reason             String?    @db.Text
  status             String     @default("pending") // pending | approved | rejected
  // Resolved at creation time: which school this request was routed within
  // (the assignment itself may have no schoolId — e.g. course-chapter
  // assignments only carry courseId — so this is the student's own school
  // for that course, resolved via CourseAccess ∩ the student's enrollments)
  // and which teacher(s) can act on this.
  schoolId           String?
  targetTeacherIds   Int[]      @default([])
  decidedByTeacherId Int?
  decidedByTeacher   User?      @relation("TeacherRetakeRequestDecisions", fields: [decidedByTeacherId], references: [id], onDelete: SetNull)
  teacherRemarks     String?    @db.Text
  createdAt          DateTime   @default(now())
  decidedAt          DateTime?
  @@index([assignmentId])
  @@index([studentId])
  @@index([status])
}

model StudentScore {
  id                 String   @id @default(uuid())
  studentId          Int
  student            User     @relation("StudentScoreOwner", fields: [studentId], references: [id], onDelete: Cascade)
  schoolId           String?
  school             School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  gradeId            String?
  grade              Grade?   @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  courseId           String?
  course             Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  subject            String?
  academicYear       String   @default("2024-25")
  cumulativeScore    Float    @default(0)
  cumulativeMaxScore Float    @default(0)
  percentage         Float    @default(0)
  gpaLikeScore       Float    @default(0)
  scoringRule        String   @default("latest") // highest | latest
  updatedAt          DateTime @updatedAt
  @@unique([studentId, courseId, subject])
  @@index([studentId])
  @@index([schoolId])
  @@index([gradeId])
  @@index([courseId])
  @@index([studentId, schoolId, academicYear])
}

// ============ School-wide student score summary (recalculated on each grading) ============
model StudentScoreSummary {
  id                     String   @id @default(uuid())
  studentId              Int      @unique
  schoolId               String?
  academicYear           String   @default("2024-25")
  courseAssignmentScore  Float    @default(0)
  dailyAssignmentScore   Float    @default(0)
  overallScore           Float    @default(0)
  courseAssignmentRank   Int      @default(0)
  dailyAssignmentRank    Int      @default(0)
  overallRank            Int      @default(0)
  badge                  String   @default("NONE") // GOLD | SILVER | BRONZE | NONE
  lastCalculatedAt       DateTime @default(now())
  @@index([schoolId])
  @@index([schoolId, overallScore])
  @@index([schoolId, academicYear])
}

model AssignmentQuestion {
  id           String   @id @default(uuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  questionType String   // MCQ | FillBlank
  questionText String   @db.Text
  options      Json?    // string[] for MCQ
  correctAnswer String?
  marks        Int      @default(1)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  @@index([assignmentId])
}

model CourseAccess {
  id        String             @id @default(uuid())
  courseId  String
  course    Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  schoolId  String
  school    School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  // grades[] replaced by CourseAccessGrade junction table for relational integrity
  gradeAccess CourseAccessGrade[]
  createdAt DateTime           @default(now())
  @@unique([courseId, schoolId])
  @@index([courseId])
  @@index([schoolId])
}

// Junction table: which grades in a school can access a course.
// Replaces the old CourseAccess.grades String[] denormalized array.
model CourseAccessGrade {
  id             String                @id @default(uuid())
  courseAccessId String
  courseAccess   CourseAccess          @relation(fields: [courseAccessId], references: [id], onDelete: Cascade)
  gradeName      String                // e.g. "Grade 1" — matches StudentSchool.grade for enrollment logic
  sectionAccess  CourseAccessSection[]
  createdAt      DateTime              @default(now())
  @@unique([courseAccessId, gradeName])
  @@index([courseAccessId])
}

// Junction table: which sections WITHIN a granted grade can access a course.
// NO rows for a grade = the whole grade (every section) — this preserves the
// behavior of every course created before section targeting existed. Rows
// present = only those sections are enrolled. sectionName matches
// StudentSchool.section for enrollment logic.
model CourseAccessSection {
  id                  String            @id @default(uuid())
  courseAccessGradeId String
  courseAccessGrade   CourseAccessGrade @relation(fields: [courseAccessGradeId], references: [id], onDelete: Cascade)
  sectionName         String
  createdAt           DateTime          @default(now())
  @@unique([courseAccessGradeId, sectionName])
  @@index([courseAccessGradeId])
}

// ============ Student progress ============
model StudentCourse {
  id          String    @id @default(uuid())
  studentId   Int
  courseId    String
  enrolledAt  DateTime  @default(now())
  // Single source of truth for course completion. Set when all chapters are done.
  completedAt DateTime?
  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
  @@index([completedAt])
  @@index([studentId, completedAt])
}

model CourseProgress {
  id           String   @id @default(uuid())
  studentId    Int
  courseId     String
  chapterId    String?
  contentId    String?
  progress     Float    @default(0)
  updatedAt    DateTime @updatedAt
  completedAt  DateTime?

  @@unique([studentId, courseId, chapterId, contentId])
  @@index([studentId])
  @@index([courseId])
  @@index([studentId, courseId])
}

// ============ Rooms & Periods ============
model Room {
  id        String   @id @default(uuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  roomNumber String?
  roomName  String?
  capacity  Int?
  location  String?
  facilities String[] @default([])
  isActive  Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([schoolId])
}

model Period {
  id           String   @id @default(uuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  periodNumber Int
  startTime    String
  endTime      String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([schoolId])
}

// ============ Schedules ============
model ClassSchedule {
  id        String   @id @default(uuid())
  schoolId  String
  periodId  String
  teacherId Int?
  roomId    String?
  dayOfWeek Int
  grade     String?
  subject   String?
  classId   String?
  academicYear String? @default("2024-25")
  startTime String?
  endTime   String?
  notes     String?
  isActive  Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([schoolId, dayOfWeek, isActive])
  @@index([teacherId])
  @@index([roomId])
}

// ============ School Calendar (Holidays & Breaks) ============
model SchoolCalendar {
  id           String    @id @default(uuid())
  schoolId     String
  school       School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  date         DateTime
  endDate      DateTime?
  name         String    // short reason, e.g. "Diwali" — shown as the holiday's reason
  type         String    // Holiday | Break | HalfDay | CompensatoryWork
  academicYear String    @default("2024-25")
  description  String?
  isActive     Boolean   @default(true)
  // Set when an admin applies one holiday to every school at once — lets the
  // UI group and bulk-edit/delete the resulting per-school rows precisely,
  // instead of guessing which rows belong together from date+name matching.
  batchId      String?
  createdByUserId Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  @@index([schoolId])
  @@index([date])
  @@index([schoolId, date])
  @@index([batchId])
}

// ============ Reports & Attendance ============
model TeacherReport {
  id            String      @id @default(uuid())
  teacherId     Int
  schoolId      String
  reportDate    DateTime
  grade         String?
  periodId      String?
  status        String?     @default("submitted") // submitted | approved | rejected
  startTime     String?
  endTime       String?
  topicsTaught  String?     @db.Text
  activities    String?     @db.Text
  studentCount  Int?
  durationHours Float?
  notes         String?     @db.Text
  adminNotes    String?     @db.Text
  // Link to the admin-verified attendance record for the same day (optional).
  // Attendance = admin-verified presence; TeacherReport = teacher self-reported work.
  attendanceId  String?
  attendance    Attendance? @relation(fields: [attendanceId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())
  @@index([teacherId])
  @@index([schoolId])
  @@index([reportDate])
  @@index([teacherId, schoolId, reportDate])
  @@index([teacherId, schoolId, reportDate, periodId])
  @@unique([teacherId, schoolId, reportDate, periodId])
}

model TeacherLeave {
  id            String    @id @default(uuid())
  teacherId     Int
  schoolId      String
  teacher       User      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  startDate     DateTime
  endDate       DateTime
  reason        String?
  leaveType     String    @default("General")
  substituteRequired Boolean @default(false)
  status        String    @default("pending")
  adminRemarks  String?
  approvedBy    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  @@index([teacherId])
  @@index([schoolId])
  @@index([status])
  @@index([teacherId, schoolId, status])
}

model Attendance {
  id        String          @id @default(uuid())
  teacherId Int
  schoolId  String
  date      DateTime
  status    String
  createdAt DateTime        @default(now())
  reports   TeacherReport[]
  @@unique([teacherId, schoolId, date])
  @@index([teacherId])
  @@index([schoolId])
  @@index([date])
}

// ============ Public Logos ============
model Logo {
  id          String   @id @default(uuid())
  schoolName  String
  schoolId    String?
  description String?  @db.Text
  imageUrl    String
  imageKey    String?  @db.Text
  createdAt   DateTime @default(now())
  deletedAt   DateTime?
  @@index([createdAt])
  @@index([schoolId])
}

// ============ Community Page (public + admin CMS) ============
model CommunityPageConfig {
  id               String   @id @default("default")
  heroTitle        String   @default("Yugminds Community")
  heroSubtitle     String?  @db.Text
  heroImageUrl     String?
  sectionTitles    Json?
  sectionEnabled   Json?
  sectionColors    Json?
  impactStats      Json?
  socialLinks      Json?
  cornerPillars    Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model CommunityItem {
  id                 String   @id @default(uuid())
  sectionType        String   // reel | profile | project | learn_video | challenge | blog
  title              String
  subtitle           String?
  description        String?  @db.Text
  mediaUrl           String?
  thumbnailUrl       String?
  creatorName        String?
  creatorAvatarUrl   String?
  externalUrl        String?
  ctaLabel           String?
  ctaUrl             String?
  likes              Int      @default(0)
  views              Int      @default(0)
  metadata           Json?
  orderIndex         Int      @default(0)
  isPublished        Boolean  @default(false)
  isFeatured         Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  versions           CommunityItemVersion[]
  @@index([sectionType, isPublished, orderIndex])
  @@index([isFeatured])
  @@index([updatedAt])
}

model CommunityItemVersion {
  id            String        @id @default(uuid())
  itemId        String
  item          CommunityItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  versionNumber Int
  snapshot      Json
  createdAt     DateTime      @default(now())
  @@unique([itemId, versionNumber])
  @@index([itemId])
}

// ============ Join Codes (per section; optional sectionId/gradeId for section-linked codes) ============
model JoinCode {
  id        String    @id @default(uuid())
  schoolId  String
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  gradeId   String?
  sectionId String?
  grade     String    // display name e.g. "Grade 1" (kept for backward compatibility)
  section   Section?  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  gradeRef  Grade?    @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  code      String    @unique
  usageType String    @default("single")
  maxUses   Int?
  usedCount Int       @default(0)
  isActive  Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  @@index([schoolId])
  @@index([code])
  @@index([sectionId])
  @@index([gradeId])
}

// ============ Notifications ============
model Notification {
  id        String    @id @default(uuid())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderId  Int?
  sender    User?     @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)
  title     String
  message   String    @db.Text
  mode      String?   // course_enrollment | assignment_due | grade_posted | system_alert | achievement | general (stored as mode in DB)
  allowReplies Boolean @default(true) // when false, recipients/sender cannot post replies
  // Shared by every per-recipient row created from one sendBroadcast() call, so
  // the "Sent" view can group a broadcast's fan-out by an actual identifier
  // instead of guessing from title/message/minute (which merges two distinct
  // broadcasts sent within the same minute).
  broadcastId String?
  readAt    DateTime?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  replies   NotificationReply[]
  @@index([userId])
  @@index([userId, readAt])
  @@index([senderId])
  @@index([broadcastId])
}

model NotificationReply {
  id             String       @id @default(uuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         Int
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  replyText      String       @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  @@index([notificationId])
  @@index([userId])
}

// ============ Password reset requests (admin-approved flow) ============
model PasswordResetRequest {
  id                  String    @id @default(uuid())
  userId              Int
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status              String    @default("pending") // pending | approved | rejected | completed
  requestedAt         DateTime  @default(now())
  approvedAt          DateTime?
  approvedBy          Int?
  approvedByUser      User?     @relation("ApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)
  schoolId            String?
  notes               String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  @@index([userId])
  @@index([status])
  @@index([schoolId])
}

model AuthActivity {
  id            String   @id @default(uuid())
  userId        Int?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email         String?
  action        String
  success       Boolean  @default(false)
  failureReason String?  @db.Text
  ipAddress     String?
  userAgent     String?  @db.Text
  metadata      Json?
  createdAt     DateTime @default(now())
  @@index([userId])
  @@index([email])
  @@index([action])
  @@index([createdAt])
}

// ============ System Settings ============
model SystemSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String @db.Text
  @@index([key])
}

// ============ RoboCoders Studio licenses (offline activation keys per system) ============
// One row per licensed machine/system. The activationKey is generated server-side
// using AES-256-CTR + HMAC-SHA256 (see admin/licenses/license-crypto.ts) and is
// byte-identical to the keys the RoboCoders Studio desktop app verifies offline.
model RobocodersLicense {
  id            String   @id @default(uuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  systemLabel   String   // admin's mark for the machine, e.g. "Lab PC 3" / "System 1"
  machineId     String   // 16 hex chars, shown on the desktop app activation screen
  licenseNumber Int      // internal reference number baked into the key (0..99999)
  startDate     DateTime // first day the license is valid (UTC date)
  expiryDate    DateTime // last day the license is valid, inclusive (UTC date)
  durationDays  Int      // convenience copy of expiry-start in days
  activationKey String   // 21-char Base32 key (grouped with dashes)
  notes         String?  @db.Text
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([schoolId])
  @@index([machineId])
  @@index([schoolId, machineId])
}

// ============================================================
// Issue 7: Unified user–school membership view (read-only)
// Created by migration 20260610000001_consolidation_fixes.
// Unions TeacherSchool + StudentSchool + SchoolAdmin so cross-role
// queries can use one surface instead of joining three tables.
// Writes must still target the three original tables.
// ============================================================
view UserSchoolMembership {
  id        String
  userId    Int
  schoolId  String
  role      String   // teacher | student | school_admin
  createdAt DateTime

  @@unique([id])
  @@map("UserSchoolMembership")
}

// ============ Contact Submissions ============
model ContactSubmission {
  id          String   @id @default(uuid())
  firstName   String
  lastName    String
  email       String
  areaCode    String   @default("+91")
  phoneNumber String?
  purpose     String
  message     String   @db.Text
  status      String   @default("new") // new | read | replied | archived
  adminNotes  String?  @db.Text
  source      String   @default("robocoders")
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([email])
  @@index([createdAt])
  @@index([deletedAt])
}

// ============ Admin Audit Log ============
// Records every admin-surface mutation (who did what, to which entity, from where).
// Written by AuditInterceptor; queried by /admin/audit-logs.
model AuditLog {
  id         String   @id @default(uuid())
  actorId    Int?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String?
  actorRole  String?
  method     String // POST | PUT | PATCH | DELETE
  path       String
  entityType String? // schools | students | teachers | courses | ...
  entityId   String?
  payload    Json? // sanitized request body (passwords stripped)
  statusCode Int?
  success    Boolean  @default(true)
  ipAddress  String?
  userAgent  String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType])
  @@index([createdAt])
  @@index([method])
}

// ============ Admin Saved Table Views ============
// A named filter/sort/column combination for an admin data table (students, teachers, ...).
model AdminSavedView {
  id        String   @id @default(uuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tableKey  String // students | teachers | schools | courses
  name      String
  state     Json // arbitrary filter/sort/column state owned by the frontend
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, tableKey, name])
  @@index([userId, tableKey])
}
