# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@host:5432/yugminds

# ─── Auth / JWT ──────────────────────────────────────────────────────────────
# Strong random secrets — generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret

# Token lifetimes — format: <number><s|m|h|d> (e.g. 15m, 7d)
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# ─── Security ────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:3000

# Secret for internal service-to-service requests
INTERNAL_API_KEY=change_me_internal_api_key

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# Maximum JSON body size (optional — defaults to 1mb)
# JSON_BODY_LIMIT=1mb

# ─── Feature flags ───────────────────────────────────────────────────────────
# Set to "true" to enable assignment retake feature
# ASSIGNMENT_RETAKE_FEATURE_ENABLED=true

# ─── RoboCoders Studio licensing ─────────────────────────────────────────────
# Base64 HMAC secret used to generate/verify offline activation keys. MUST match
# the secret baked into the RoboCoders Studio desktop app (and admin-portal/src/keys.js).
# Required — the app refuses to generate/verify keys if this is unset. Generate
# a real value with: openssl rand -base64 32
# Get the actual value from a teammate or secrets manager — never commit it here.
ROBOCODERS_LICENSE_SECRET=

# ─── Admin seed (first-run bootstrap) ────────────────────────────────────────
# If set and no user with ADMIN_SEED_EMAIL exists, a super-admin is created on
# server start. Idempotent — safe to leave set permanently across deploys.
ADMIN_SEED_EMAIL=admin@yugminds.com
ADMIN_SEED_PASSWORD=change_me_strong_password

# ─── Redis ───────────────────────────────────────────────────────────────────
# Backs the ranking cache, rate-limiter storage, and JWT user-lookup cache.
# Required once running more than one backend instance.
REDIS_URL=redis://localhost:6379

# ─── Object storage (S3-compatible) ──────────────────────────────────────────
# Works against AWS S3 or any S3-compatible provider (e.g. MinIO on Coolify).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=yugminds-uploads
# Base URL used to construct public object links returned to the frontend.
S3_PUBLIC_URL=http://localhost:9000/yugminds-uploads
# Required for MinIO / most non-AWS S3-compatible providers.
S3_FORCE_PATH_STYLE=true
